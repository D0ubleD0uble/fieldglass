// Level 2-3: inside the format crates. Each reader parses a file into one
// message that holds its sections; where a section's layout depends on a
// type code, the message carries a template enum and the variant in hand is
// the one the code selected. Mirrors docs/architecture/03-composition.md.

model {

  // =========================================================== GRIB2

  extend fieldglass.grib2 {

    g2reader = module 'Grib2Reader' 'Walks the file into messages, then decodes one on request. Sections that are large or optional stay byte ranges, which keeps scanning a file cheap.' {
      technology 'grib2/src/reader.rs'
    }

    g2message = part 'Grib2Message' 'One message, every WMO section. Carries message_index, byte_offset and lus_range; the bitmap and data sections stay as ranges into the buffer.' {
      technology 'grib2/src/section.rs'

      g2is = part 'IndicatorSection (§0)' 'GRIB magic, discipline, total length. Distinct from the GRIB1 type of the same name.'
      ids = part 'IdentificationSection (§1)' 'Centre, sub-centre, reference time, production status.'
      lus = part 'LocalUseSection (§2)' 'Kept as a byte range; centre-specific and decoded only where a local table needs it.'
      gds = part 'GridDefinitionSection (§3)' 'Carries GridTemplate. This is the section projection and warp read; nothing about packing reaches them.'
      pds = part 'ProductDefinitionSection (§4)' 'Carries ProductTemplate: which parameter, which level, which time window.'
      drs = part 'DataRepresentationSection (§5)' 'Carries DataRepresentationTemplate — the packing. The README GRIB2 packing modes table is the single source of truth for which of these decode.'
      bms = part 'BitMapSection (§6)' 'Which grid points carry a value. Decodes to the None entries of Vec<Option<f64>>.'
      ds = part 'DataSection (§7)' 'The packed bit-stream. Kept as a range and unpacked only when values are asked for.'
    }

    gridTemplate = part 'GridTemplate' 'One variant per §3 grid definition template. Converts into core s GridGeometry; that conversion is the whole of what projection knows about GRIB2.' {
      latlon = part 'LatLonTemplate (3.0)'
      rotated = part 'RotatedLatLonTemplate (3.1)'
      mercator = part 'MercatorTemplate (3.10)'
      transverse = part 'TransverseMercatorTemplate (3.12)'
      polarStereo = part 'PolarStereographicTemplate (3.20)'
      lambertT = part 'LambertTemplate (3.30)'
      lambertAz = part 'LambertAzimuthalTemplate (3.140)'
      gaussian = part 'GaussianTemplate (3.40)' 'Regular and reduced. A reduced grid s rows differ in width, so ni means the widest row — the raster it expands into (#503).'
      spaceView = part 'SpaceViewTemplate (3.90)' 'Geostationary. Shares its projector with the NetCDF GOES path (ADR-0004).'
      sphericalT = part 'SphericalHarmonicTemplate (3.50)' 'Synthesised onto a lat/lon grid at decode.'
      biFourierT = part 'BiFourierTemplate'
      healpixT = part 'HealpixTemplate (3.150)' 'Nside plus ring-or-nested ordering; geolocated through the spatial index.'
    }

    productTemplate = part 'ProductDefinitionTemplate' 'Which quantity, at which level, over which time.' {
      t40 = part 'Template 4.0' 'Analysis or forecast at a horizontal level.'
      t48 = part 'Template 4.8' 'Statistically processed over a time interval.'
      t411 = part 'Template 4.11' 'Ensemble member, statistically processed.'
    }

    drsTemplate = part 'DataRepresentationTemplate' 'The packing. A new one lands here and nowhere else: projection, overlays and manual bounds run on the decoded field, not on the packing.' {
      simple = part 'Simple packing (5.0)'
      matrixSimple = part 'Matrix simple packing (5.1)'
      complex = part 'Complex packing (5.2)'
      spatialDiff = part 'Complex + spatial differencing (5.3)'
      ieee = part 'IEEE floating point (5.4)'
      png = part 'PNG (5.41)' 'Pure-Rust png crate (ADR-0001).'
      ccsds = part 'CCSDS / AEC (5.42)' 'rust-aec. The first pick, oxiarc-szip, decoded its own round-trips but was not byte-compatible with real libaec streams (ADR-0001 amendment).'
      jpeg2000 = part 'JPEG 2000 (5.40)' 'rust-j2k, pure Rust. #463 will let a caller decode at a lower wavelet level, returning a derived geometry rather than the message GDS.'
      runLength = part 'Run-length (5.200)'
      logPre = part 'Logarithmic pre-processing (5.6)'
      spectralSimple = part 'Spectral simple (5.50)'
      spectralComplex = part 'Spectral complex (5.51)'
      biFourierP = part 'Bi-Fourier packing'
      secondOrder = part 'Second-order packing'
    }

    g2tables = module 'tables' 'WMO ON388 / FM 92 plus the local tables. Extended here in Rust, never at the napi or TypeScript layer; some are generated by tools/ scripts.' {
      technology 'tables_wmo.rs, tables_ncep.rs, tables_ecmf.rs, tables_edzw.rs, tables_cct.rs, tables_local.rs'
    }

    g2spectral = module 'spectral' 'Synthesises spherical-harmonic coefficients onto a fixed lat/lon grid before rendering, so downstream sees an ordinary field.'

    g2reader -> g2message 'parses into'
    g2message -> gridTemplate 'selects one variant of'
    g2message -> productTemplate 'selects one variant of'
    g2message -> drsTemplate 'selects one variant of'
    productTemplate -> g2tables 'resolves parameter names through'
    gridTemplate -> fieldglass.core.projection.gridGeometry 'converts into (From)'
    drsTemplate -> fieldglass.core.support.bits 'unpacks through'
  }

  // =========================================================== GRIB1

  extend fieldglass.grib1 {

    g1reader = module 'Grib1Reader' 'Flatter than GRIB2: the grid description is optional, and the bitmap and data sections stay byte ranges decoded on request.' {
      technology 'grib1/src/reader.rs'
    }

    g1message = part 'Grib1Message' 'message_index, byte_offset, an optional GridDescription, bms_range and bds_range.' {
      g1is = part 'IndicatorSection' 'Distinct type from the GRIB2 section of the same name — one per crate.'
      g1pds = part 'ProductDefinition' 'Table version, centre, parameter, level, time.'
      g1bms = part 'Bitmap (range)'
      g1bds = part 'Binary data section (range)' 'Its flag byte names the packing.'
    }

    g1grid = part 'GridDescription' 'Optional. Where it is absent the grid comes from a predefined catalogue keyed on centre and grid number.' {
      g1latlon = part 'LatLonGrid'
      g1rotated = part 'RotatedLatLonGrid'
      g1reduced = part 'ReducedLatLonGrid'
      g1gaussian = part 'GaussianGrid'
      g1reducedGauss = part 'ReducedGaussianGrid'
      g1polar = part 'PolarStereoGrid'
      g1lambert = part 'LambertGrid'
      g1spherical = part 'SphericalHarmonicGrid'
    }

    g1packing = seam 'Grib1Packing' 'The dispatch point for GRIB1 packing. The reader matches the BDS flag byte to one implementer, which unpacks the bit-stream into the common field of values.' {
      technology 'grib1/src/packing/'

      p1simple = impl 'SimplePacking'
      p1complex = impl 'ComplexPacking' 'Second-order packing, with the spatial-differencing inverse milestone 7 proves (#200).'
      p1ieee = impl 'IeeePacking'
      p1matrix = impl 'MatrixPacking' 'The exception to "decode is decoupled from rendering": matrixOfValues is not one scalar per grid point, so it uses its own path rather than decode_message_values.'
      p1spherical = impl 'SphericalPacking'
    }

    g1predef = module 'predefined' 'Predefined grid catalogue for messages that omit the GDS.'
    g1tables = module 'tables' 'WMO table 2 plus the ECMWF local table, the latter generated by a tools/ script.'

    g1reader -> g1message 'parses into'
    g1message -> g1grid 'may carry'
    g1message -> g1packing 'unpacks through'
    g1grid -> fieldglass.core.projection.gridGeometry 'converts into (From)'
    g1message -> g1predef 'falls back to, when the GDS is absent'
  }

  // ========================================================== NetCDF

  extend fieldglass.netcdf {

    ncreader = module 'NetcdfReader' 'One reader over two on-disk layouts. Classic CDF is parsed fully up front; HDF5 is parsed by a deep walk of the object model.' {
      technology 'netcdf/src/reader.rs'

      backing = part 'NetcdfBacking' 'The enum that picks the layout: Classic or Hdf5.'
    }

    classic = module 'classic (CDF-1/2/5)' 'Header parsed in full up front: dimensions, global attributes, variables and their attributes fall out for free.' {
      technology 'netcdf/src/classic.rs'

      dimension = part 'Dimension'
      attribute = part 'Attribute'
      variable = part 'Variable'
    }

    hdf5 = module 'hdf5 (NetCDF-4)' 'A deep walk of the HDF5 object model: object headers, groups, datasets, dataspaces, datatypes, and attributes — including dense attributes held in a fractal heap indexed by a B-tree.' {
      technology 'netcdf/src/hdf5/'

      objectHeader = part 'ObjectHeader' 'Versioned; the walk starts at the root group and follows links.'
      headerMessage = part 'HeaderMessage'
      datasetShape = part 'DatasetShape'
      dataspace = part 'Dataspace'
      datatype = part 'Datatype'
      dimScales = part 'Dimension scales' 'The netCDF-4 semantic layer on top of HDF5: CLASS = DIMENSION_SCALE, NAME, DIMENSION_LIST and _Netcdf4Dimid map anonymous HDF5 datasets to named, shared netCDF dimensions (ADR-0003).' {
        link https://github.com/D0ubleD0uble/fieldglass/blob/master/docs/decisions/0003-netcdf4-dimension-scale-resolution.md 'ADR-0003'
      }
      chunks = part 'ChunkRecord' 'address, size, filter_mask, offset. Chunk reads already split plan from fetch, which is what made the ByteSource migration mechanical rather than a redesign.'
    }

    ncgeometry = module 'geometry' 'NetCDF carries no GDS, so geolocation is reconstructed. Three models, and which one applies is a property of the file (ADR-0002, ADR-0004).' {
      technology 'netcdf/src/geometry.rs, projection.rs'
      link https://github.com/D0ubleD0uble/fieldglass/blob/master/docs/decisions/0004-netcdf-projected-grid-geolocation.md 'ADR-0004'

      renderable = part 'RenderableVariable' 'A variable the slice picker can draw: its ordered dimensions, its image axes, and where its geolocation comes from.'
      modelA1 = part '1-D coordinate variables' 'CF axis detection: a lat/lon pair of 1-D coordinate variables synthesises a latlon geometry and reuses the GRIB warp unchanged (ADR-0002).'
      modelA2 = part 'Reconstructed projection' 'WRF Lambert, GOES geostationary: rebuild the analytic projection from the file s attributes and use the ordinary projector (ADR-0004 Model A).'
      modelB = part 'Curvilinear (2-D coordinates)' 'CurvilinearCoords holds decode indices, not arrays. Resolved from the CF coordinates attribute, which may name more than the pair — RTOFS writes "Longitude Latitude Date" (ADR-0004 Model B, #445).'
    }

    ncunits = module 'units' 'File-authored units are typeset for notation, never renamed: m/s becomes m s⁻¹, meters stays meters, time encodings are refused by rule (ADR-0007).'

    ncreader -> classic 'parses, when the backing is Classic'
    ncreader -> hdf5 'walks, when the backing is HDF5'
    hdf5 -> ncgeometry 'resolves dimensions and coordinates for'
    classic -> ncgeometry 'resolves dimensions and coordinates for'
    ncgeometry -> fieldglass.core.projection.gridGeometry 'converts into (From)'
    ncgeometry -> fieldglass.core.spatialIndex.index 'builds, for the curvilinear model'
    ncreader -> fieldglass.core.bytes.byteSource 'reads through (classic migrated, #438)'
  }

  // ============================================================ Zarr

  extend fieldglass.zarr {
    codecs = module 'chunk codecs' 'zstd via ruzstd, blosc, shuffle, and v3 shard inner chunks. Nothing about addressing: that is fetchplan s.' {
      #planned
    }
  }
}
